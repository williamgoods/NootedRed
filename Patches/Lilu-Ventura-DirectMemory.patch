+void UserPatcher::performDirectPagePatch(const uint8_t *page, size_t pageSize) {
+	if (!page || pageSize == 0)
+		return;
+
+	// Heartbeat: proves the cs_validate hook is firing.  Logged sparsely so it
+	// does not flood the log on the hot code-signing path.
+	uint64_t scanned = atomic_fetch_add_explicit(&directPagesScanned, 1, memory_order_relaxed) + 1;
+	if (scanned == 1 || (scanned & 0x3FFFF) == 0)
+		SYSLOG("user", "direct page patch scan heartbeat %llu", scanned);
+
+	auto mod = directBinaryMod;
+	if (mod == nullptr)
+		return;
+
+	for (size_t p = 0; p < mod->count; p++) {
+		auto &patch = mod->patches[p];
+		if (patch.section == ProcInfo::SectionDisabled || !(patch.flags & DirectMemory) ||
+			patch.cpu != CPU_TYPE_X86_64 ||
+			!patch.find || !patch.replace || patch.size == 0 || patch.size > pageSize || patch.count == 0)
+			continue;
+
+		auto current = page;
+		auto last = page + pageSize - patch.size;
+		size_t skip = patch.skip;
+		size_t count = patch.count;
+
+		while (current <= last && count != 0) {
+			if (*current != *patch.find || memcmp(current, patch.find, patch.size) != 0) {
+				// Prefix near-miss probe: if a decent prefix of the signature
+				// matches but the full pattern does not, log it once per patch.
+				// This distinguishes "the target code page never flows through"
+				// from "it does, but the bytes differ from what we hard-coded".
+				if (*current == *patch.find && patch.size >= 8 && memcmp(current, patch.find, 8) == 0 &&
+					p < sizeof(directPrefixLogMask) * 8) {
+					const uint32_t bit = 1U << p;
+					if (!(atomic_fetch_or_explicit(&directPrefixLogMask, bit, memory_order_relaxed) & bit))
+						SYSLOG("user", "direct patch %lu prefix matched but full %lu-byte signature did not; "
+							"page bytes %02X %02X %02X %02X %02X %02X %02X %02X",
+							p, patch.size, current[0], current[1], current[2], current[3],
+							current[4], current[5], current[6], current[7]);
+				}
+				current++;
+				continue;
+			}
+
+			if (skip != 0) {
+				skip--;
+				current += patch.size;
+				continue;
+			}
+
+			DBGLOG("user", "found direct page patch %lu (%lu bytes)", p, patch.size);
+			if (MachInfo::setKernelWriting(true, KernelPatcher::kernelWriteLock) != KERN_SUCCESS) {
+				SYSLOG("user", "failed to obtain write permissions for direct page patch %lu", p);
+				break;
+			}
+
+			lilu_os_memcpy(const_cast<uint8_t *>(current), patch.replace, patch.size);
+			if (p < sizeof(directPatchLogMask) * 8) {
+				const uint32_t bit = 1U << p;
+				if (!(atomic_fetch_or_explicit(&directPatchLogMask, bit, memory_order_relaxed) & bit))
+					SYSLOG("user", "applied NRed direct page patch %lu (%lu bytes)", p, patch.size);
+			}
+			if (MachInfo::setKernelWriting(false, KernelPatcher::kernelWriteLock) != KERN_SUCCESS)
+				SYSLOG("user", "failed to restore write permissions after direct page patch %lu", p);
+
+			count--;
+			current += patch.size;
+		}
+	}
+}
