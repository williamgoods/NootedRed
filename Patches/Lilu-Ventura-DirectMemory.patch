+bool UserPatcher::registerDirectPatchEarly(KernelPatcher &kernelPatcher, BinaryModInfo *mod) {
+	if (mod == nullptr || mod->patches == nullptr || mod->count == 0 || directBinaryMod != nullptr) {
+		SYSLOG("user", "rejected invalid or duplicate early DirectMemory registration");
+		return false;
+	}
+
+	for (size_t p = 0; p < mod->count; p++) {
+		auto &patch = mod->patches[p];
+		if (patch.section != ProcInfo::SectionDisabled &&
+			(!(patch.flags & DirectMemory) || patch.cpu != CPU_TYPE_X86_64 ||
+			 patch.find == nullptr || patch.replace == nullptr || patch.size < 16 ||
+			 patch.count != 1)) {
+			SYSLOG("user", "rejected unsafe early DirectMemory patch %lu", p);
+			return false;
+		}
+	}
+
+	that = this;
+	patcher = &kernelPatcher;
+	directBinaryMod = mod;
+
+	if (!hookDirectMemoryAccess()) {
+		directBinaryMod = nullptr;
+		return false;
+	}
+
+	activate();
+	SYSLOG("user", "v6 early DirectMemory patcher active before graphics console");
+	return true;
+}
