+bool UserPatcher::hookDirectMemoryAccess() {
+	if (atomic_load_explicit(&directHookInstalled, memory_order_relaxed))
+		return true;
+
+	// Ventura keeps cs_validate_range for explicit range validation, but normal
+	// file-backed Mach-O page faults use the newer seven-argument
+	// cs_validate_page ABI.  Routing only the first symbol therefore reports
+	// success while missing standalone dylibs such as AMDRadeonX5000GLDriver.
+	if (getKernelVersion() == KernelVersion::Ventura) {
+		KernelPatcher::RouteRequest routes[] {
+			{"_cs_validate_range", codeSignValidateRangeWrapper, orgCodeSignValidateRangeWrapper},
+			{"_cs_validate_page", codeSignValidatePageVenturaWrapper, orgCodeSignValidatePageWrapper},
+		};
+		if (!patcher->routeMultipleLong(KernelPatcher::KernelID, routes, arrsize(routes))) {
+			SYSLOG("user", "DirectMemory failed to route Ventura cs_validate_range/page pair");
+			return false;
+		}
+
+		atomic_store_explicit(&directHookInstalled, true, memory_order_relaxed);
+		SYSLOG("user", "DirectMemory v7 routed Ventura cs_validate_range/page pair");
+		return true;
+	}
+
+	KernelPatcher::RouteRequest rangeRoute {"_cs_validate_range", codeSignValidateRangeWrapper, orgCodeSignValidateRangeWrapper};
+	if (patcher->routeMultipleLong(KernelPatcher::KernelID, &rangeRoute, 1)) {
+		atomic_store_explicit(&directHookInstalled, true, memory_order_relaxed);
+		SYSLOG("user", "DirectMemory routed _cs_validate_range");
+		return true;
+	}
+
+	patcher->clearError();
+	KernelPatcher::RouteRequest pageRoute {"_cs_validate_page", codeSignValidatePageWrapper, orgCodeSignValidatePageWrapper};
+	if (patcher->routeMultipleLong(KernelPatcher::KernelID, &pageRoute, 1)) {
+		atomic_store_explicit(&directHookInstalled, true, memory_order_relaxed);
+		SYSLOG("user", "DirectMemory routed _cs_validate_page");
+		return true;
+	}
+
+	SYSLOG("user", "DirectMemory failed to resolve both cs_validate hooks");
+	return false;
+}
