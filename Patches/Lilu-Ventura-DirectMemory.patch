+LiluAPI::Error LiluAPI::activateNRedDirectUserPatch(UserPatcher::BinaryModInfo *mod) {
+	constexpr const char *NRedGLDriverPath =
+		"/System/Library/Extensions/AMDRadeonX5000GLDriver.bundle/Contents/MacOS/AMDRadeonX5000GLDriver";
+
+	if (getKernelVersion() != KernelVersion::Ventura)
+		return Error::IncompatibleOS;
+	if (ADDPR(config).isUserDisabled || !checkKernelArgument("-lilunreduser"))
+		return Error::Disabled;
+	if (mod == nullptr || mod->path == nullptr || strcmp(mod->path, NRedGLDriverPath) != 0)
+		return Error::UnsupportedFeature;
+
+	return ADDPR(config).activateNRedDirectUserPatch(mod) ? Error::NoError : Error::Offline;
+}
